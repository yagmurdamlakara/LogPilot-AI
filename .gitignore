# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Secrets and local configuration
.env
.env.*
!.env.example

# Test, coverage, and type-check caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# IDE and editor
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# Logs and temporary files
*.log
*.tmp

# Generated datasets: keep placeholders, never commit raw/processed data
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/samples/*
!data/samples/.gitkeep

# OS
.DS_Store
Thumbs.db
